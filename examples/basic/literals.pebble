var character = 'A';              // ASCII character literal
var str1 = "Hello world!";        // inferred the string (slice) type
var str2: *char = "Hello world!"; // casted to the *char type
var int = 10;                     // inferred the int32 type
var i8: int8 = 10;                // 10 is represented as an int8 type
var uint = 10u32;                 // u32 is a suffix for type uint32
                                  // any number type name can
                                  // be used as a suffix
                                  // e.g. 10f32 for float32, 123i8 for int8,
                                  // or 64u16 for uint16
var double = 10.0;                // floating number without suffix is float64 by default
var double2 = .5;                 // floating number like `.x` and `0.x` are identical
var float = 1.23f32;              // inferred the float32 type
