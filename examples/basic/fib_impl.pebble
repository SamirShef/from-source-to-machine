fb fib(n: int32): int32 {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }

    var prev1: uint64 = 0;
    var prev2: uint64 = 1;
    var cur:   uint64 = 0;

    for var i = 2, i <= n, i++ {
        cur   = prev1 + prev2;
        prev1 = prev2;
        prev2 = cur;
    }
    return cur;
}
